# =============================================================================
# Riscly — environment configuration
# =============================================================================
# Everything here is OPTIONAL for local dev: with nothing set the app runs on
# in-memory storage, an inline job queue, heuristic AI, a local billing
# provider and dev sign-in. Set a variable to switch that subsystem to the
# real provider. See docs/CONFIGURATION.md for the full reference.
#
# Backend (API/worker) reads this file in dev via --env-file-if-exists.
# Frontend (Next.js) reads NEXT_PUBLIC_* from apps/web/.env.local.
# =============================================================================

# --- Database (PostgreSQL via Prisma) -----------------------------------------
# Unset → in-memory store. Set → PrismaStore. Supabase/Neon give you this URL.
# Supabase: use the TRANSACTION POOLER URL (port 6543) here and append
#   ?pgbouncer=true   e.g.
#   postgresql://postgres.<ref>:<pwd>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://riscly:riscly@localhost:5432/riscly?schema=public"
# Direct (non-pooled) connection used only by `prisma migrate`/introspect.
# Supabase: the SESSION POOLER or direct host on port 5432 (same password).
#   postgresql://postgres.<ref>:<pwd>@aws-0-<region>.pooler.supabase.com:5432/postgres
DIRECT_URL="postgresql://riscly:riscly@localhost:5432/riscly?schema=public"

# --- Redis / BullMQ -----------------------------------------------------------
# Unset → inline (in-process) job queue. Set → BullMQ workers.
REDIS_URL="redis://localhost:6379"

# --- Auth (Supabase) ----------------------------------------------------------
# Unset → dev sign-in (unsigned dev tokens). Set the JWT secret → real Supabase
# access tokens are verified (HS256). Find it in: Supabase → Project Settings →
# API → JWT Secret.
SUPABASE_JWT_SECRET=""
SUPABASE_URL=""                       # optional, for server-side Supabase calls

# --- AI providers -------------------------------------------------------------
# Unset → heuristic predictions only. Set → Claude augments them.
ANTHROPIC_API_KEY=""                  # console.anthropic.com → API Keys
ANTHROPIC_MODEL="claude-opus-4-8"
OPENAI_API_KEY=""                     # optional alternative LLM provider

# --- Billing (Stripe) ---------------------------------------------------------
# Unset → local billing provider (dev). Set → real Stripe Checkout + webhooks.
STRIPE_SECRET_KEY=""                  # dashboard.stripe.com → Developers → API keys
STRIPE_WEBHOOK_SECRET=""              # Stripe → Webhooks → signing secret
STRIPE_PRICE_STARTER=""               # price IDs per plan (Stripe → Products)
STRIPE_PRICE_GROWTH=""
STRIPE_PRICE_PRO=""
# Paywall: the app requires an active subscription whenever STRIPE_SECRET_KEY is
# set. Force it on without Stripe (e.g. staging) with REQUIRE_SUBSCRIPTION=true.
REQUIRE_SUBSCRIPTION=""

# --- Secrets encryption -------------------------------------------------------
# REQUIRED in production. Encrypts provider tokens at rest (AES-256-GCM).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CONNECTION_ENCRYPTION_KEY=""

# --- Provider OAuth (GitHub) --------------------------------------------------
# Unset → GitHub OAuth disabled (token/metadata connections still work).
# Create a GitHub OAuth App; callback URL = OAUTH_REDIRECT_BASE/api/oauth/github/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
OAUTH_REDIRECT_BASE="http://localhost:4000"
APP_URL="http://localhost:3000"       # where the OAuth callback returns the user

# --- Email (invitations) ------------------------------------------------------
# Unset → emails are logged (console). Set → sent via Resend.
RESEND_API_KEY=""                     # resend.com → API Keys
EMAIL_FROM="Riscly <noreply@riscly.ai>"

# --- API ----------------------------------------------------------------------
API_PORT=4000
# CORS: comma-separated allowlist of web origins (defaults to APP_URL; unset → allow all in dev)
CORS_ORIGINS=""
RATE_LIMIT_PER_MIN=600                # per-IP request cap (0 = disabled)

# --- Observability ------------------------------------------------------------
# Leave UNSET unless you actually run an OTLP collector — pointing it at a
# non-existent collector causes connection-reset noise. Then tracing is a no-op.
# OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"

# =============================================================================
# Frontend (Next.js) — put these in apps/web/.env.local
# =============================================================================
# NEXT_PUBLIC_API_URL="http://localhost:4000"
# NEXT_PUBLIC_SUPABASE_URL=""
# NEXT_PUBLIC_SUPABASE_ANON_KEY=""
